{
  "name": "@usdd/mcp-server-usdd",
  "version": "1.0.4",
  "description": "MCP server for the USDD protocol across TRON, Ethereum, and BSC. Supports vaults, PSM swaps, USDD Savings, protocol monitoring, and AI-guided risk workflows.",
  "type": "module",
  "module": "src/index.ts",
  "main": "build/index.js",
  "bin": {
    "mcp-server-usdd": "./bin/cli.js"
  },
  "files": [
    "build/",
    "bin/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "preinstall": "npm run check:node",
    "prebuild": "npm run check:node",
    "pretest": "npm run check:node",
    "prestart": "npm run check:node",
    "prestart:http": "npm run check:node",
    "predev": "npm run check:node",
    "predev:http": "npm run check:node",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start:http": "tsx src/server/http-server.ts",
    "dev:http": "tsx watch src/server/http-server.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bankofai/agent-wallet": "2.4.0",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@scure/bip32": "2.0.1",
    "@scure/bip39": "2.0.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "tronlink-signer": "0.1.4",
    "tronweb": "6.2.2",
    "viem": "2.47.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.13",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "24.22.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tron",
    "ethereum",
    "bsc",
    "usdd",
    "defi",
    "stablecoin",
    "vault",
    "makerdao",
    "ai",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentralized-usd/mcp-server-usdd.git"
  },
  "homepage": "https://github.com/decentralized-usd/mcp-server-usdd#readme",
  "bugs": {
    "url": "https://github.com/decentralized-usd/mcp-server-usdd/issues"
  },
  "license": "MIT"
}
